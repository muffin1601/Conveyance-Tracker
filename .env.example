# ── Database ─────────────────────────────────────────────
# Local dev (default): SQLite. Production: switch provider to "postgresql" in
# prisma/schema.prisma and set a Postgres URL here.
DATABASE_URL="file:./dev.db"

# ── Auth ─────────────────────────────────────────────────
# 32+ char secret used to sign session JWTs. CHANGE IN PRODUCTION.
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string-min-32"

# ── Google Maps (Distance Matrix + Geocoding) ────────────
# Optional. If unset, the distance engine falls back to the Haversine
# formula (road-factor adjusted) and geocoding uses the bundled pincode map.
GOOGLE_MAPS_API_KEY=""

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Watcon Tracker <noreply@watcon.net>"

# ── File storage (Cloudflare R2) ─────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ── Monitoring / analytics (optional) ────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
