# ── Database ─────────────────────────────────────────────
# Local dev (default): SQLite. Production: switch provider to "postgresql" in
# prisma/schema.prisma and set a Postgres URL here.
DATABASE_URL="file:./dev.db"

# ── Auth ─────────────────────────────────────────────────
# 32+ char secret used to sign session JWTs. CHANGE IN PRODUCTION.
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string-min-32"

# ── Routing (road distance) ──────────────────────────────
# Distance for every leg is measured along the ROAD NETWORK, not as a straight
# line. All three settings are optional and have working defaults.
#
#   ROUTING_PROVIDER   osrm (default) | google | none
#                      Unset picks google when a Maps key is set, else osrm.
#                      "none" disables routing entirely — every leg then falls
#                      back to a clearly-labelled straight-line estimate.
#   OSRM_BASE_URL      defaults to the public demo server. It has NO SLA and is
#                      rate-limited: point this at a self-hosted OSRM before
#                      relying on it for production volume.
#   ROUTING_TIMEOUT_MS how long to wait for a route before falling back (4000).
ROUTING_PROVIDER="osrm"
OSRM_BASE_URL="https://router.project-osrm.org"
ROUTING_TIMEOUT_MS="4000"

# ── Google Maps (Distance Matrix + Geocoding) ────────────
# Optional. If unset, the distance engine falls back to OSRM (free public
# routing) then Haversine, and GPS reverse-geocoding uses OpenStreetMap
# Nominatim (free, no key). Set a billed key for best accuracy.
GOOGLE_MAPS_API_KEY=""

# ── Supabase Storage (expense bill uploads) ──────────────
# Reuses the existing Supabase project. Without these, expenses save fine but
# file upload is disabled in the UI. The bucket is auto-created PRIVATE on
# first upload; all access is via short-lived signed URLs minted server-side.
#   SUPABASE_URL              https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY Project Settings → API → service_role (secret!)
#   SUPABASE_BILLS_BUCKET     optional, defaults to "expense-bills"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BILLS_BUCKET="expense-bills"

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Watcon Tracker <noreply@watcon.net>"

# ── File storage (Cloudflare R2) ─────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ── Monitoring / analytics (optional) ────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
